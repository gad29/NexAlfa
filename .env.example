# ============================================================
# NexAlfa Environment Configuration
# Copy to .env and fill in your values
# ============================================================

# ── Agent Name ──────────────────────────────────────────────
NEX_AGENT_NAME=Nex

# ── Model Providers (fill in the ones you use) ──────────────
# OpenAI
OPENAI_API_KEY=
# Google AI (Gemini)
GOOGLE_API_KEY=
# OpenRouter
OPENROUTER_API_KEY=
# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434

# ── Default Model ───────────────────────────────────────────
# Format: provider/model-id (e.g. openai/gpt-4o, openrouter/anthropic/claude-sonnet-4, ollama/llama3)
NEX_DEFAULT_MODEL=openai/gpt-4o

# ── Gateway ─────────────────────────────────────────────────
NEX_GATEWAY_HOST=0.0.0.0
NEX_GATEWAY_PORT=18789
NEX_GATEWAY_SECRET=change-me-to-a-random-string

# ── VPS Deployment ──────────────────────────────────────────
# Your domain name (for SSL certificates via Let's Encrypt)
NEX_DOMAIN=
# Public-facing URL (used by the web app to reach the API)
NEX_PUBLIC_URL=

# ── Channels ────────────────────────────────────────────────
# Telegram
TELEGRAM_BOT_TOKEN=
# Discord
DISCORD_BOT_TOKEN=
# Slack
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# WhatsApp (Bridge — Baileys/WhatsApp Web)
NEX_WHATSAPP_BRIDGE=true
# WhatsApp (Cloud API — Meta Business)
# Set NEX_WHATSAPP_BRIDGE=false to use Cloud API instead
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
# Google Chat
GOOGLE_CHAT_CREDENTIALS_FILE=
GOOGLE_CHAT_PROJECT_ID=
# Email
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_ADDRESS=
EMAIL_PASSWORD=

# ── Dev Mode (everything on by default — the NexAlfa way) ──
NEX_DEV_MODE=1
NEX_SHOW_THINKING=1
NEX_SAVE_ALL_HISTORY=1
NEX_RAW_CONFIG_VISIBLE=1

# ── Memory ──────────────────────────────────────────────────
NEX_MEMORY_AUTO_LEARN=1
NEX_MEMORY_AUTO_SKILLS=1
NEX_VECTOR_STORE_PATH=./storage/memory

# ── Paths ───────────────────────────────────────────────────
NEX_WORKSPACE_PATH=./workspace
NEX_STORAGE_PATH=./storage
NEX_SKILLS_PATH=./workspace/skills
